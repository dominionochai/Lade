# Cloud Run optimized Dockerfile for Lade webhook
# Multi-stage build for minimal image size

# Build stage
FROM python:3.13-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# Runtime stage
FROM python:3.13-slim AS runtime

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user
RUN groupadd -r lade && useradd -r -g lade -d /app -s /sbin/nologin lade

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=lade:lade src/ /app/src/
COPY --chown=lade:lade fixtures/incident-001/ /app/evidence/

# Set environment variables
ENV LADE_EVIDENCE_ROOT=/app/evidence
ENV LADE_DB_DIR=/tmp/lade
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER lade

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

# Run the webhook server
CMD ["lade", "serve-webhook", "--host", "0.0.0.0", "--port", "8080"]