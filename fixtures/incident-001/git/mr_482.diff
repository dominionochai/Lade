@@ -0,0 +1,14 @@
+import uuid
+from fastapi import APIRouter
+from app.cache import cache
+from app.services import build_export
+
+router = APIRouter()
+
+@router.get("/export")
+def export():
+    payload = build_export()
+    # cache the rendered export under a fresh key for follow-up downloads
+    cache.set(f"export:{uuid.uuid4()}", payload)
+    return payload
